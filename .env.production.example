# ============================================================================
# ZeroZero — Production environment template
# ----------------------------------------------------------------------------
# Copy to `.env` on the VPS:  cp .env.production.example .env
# Fill every placeholder. Do NOT commit the real `.env` file.
# Every secret below MUST be rotated away from these placeholder values.
# ============================================================================

# ---- Deployment ------------------------------------------------------------
# Public FQDN that resolves to this VPS (A/AAAA record). Caddy will
# auto-provision a Let's Encrypt certificate for it.
DOMAIN=zerozero.example.com
# Contact email for ACME/Let's Encrypt expiry notices.
ACME_EMAIL=ops@example.com
# Image tag used by docker-compose (bumped by CI on each deploy).
IMAGE_TAG=latest

# ---- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=zerozero
# 32+ chars, mixed-case + digits + symbols. Generate: `openssl rand -base64 32`
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password_min_32_chars
POSTGRES_DB=zerozero
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://zerozero:CHANGE_ME_strong_db_password_min_32_chars@db:5432/zerozero

# ---- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---- Auth / JWT ------------------------------------------------------------
# MUST be 64+ random chars. Generate: `openssl rand -hex 64`
# Rotating this invalidates all active sessions — plan accordingly.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64_chars_minimum
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ---- App -------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=info
# Comma-separated origins. Use your production domain(s).
CORS_ORIGINS=https://zerozero.example.com
# Where uploads are served from (behind Caddy /uploads/*).
UPLOAD_DIR=/app/uploads
# Max upload size (MB).
MAX_UPLOAD_MB=10

# ---- Email / SMTP ----------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=CHANGE_ME_smtp_api_key
SMTP_FROM=no-reply@zerozero.example.com

# ---- Observability ---------------------------------------------------------
# Backend Sentry DSN (server-side FastAPI). Leave blank to disable.
SENTRY_DSN=https://public_key@oXXXXXX.ingest.sentry.io/XXXXXX
# Frontend Sentry DSN (embedded in build — safe to be public, but scope it).
VITE_SENTRY_DSN=https://public_key@oXXXXXX.ingest.sentry.io/YYYYYY
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Frontend build-time vars (baked into bundle by Vite) ------------------
VITE_API_BASE_URL=https://zerozero.example.com/api
VITE_WS_BASE_URL=wss://zerozero.example.com/ws

# ---- Maps / third-party ----------------------------------------------------
# If switching off OSM to a paid tile provider, set the key here.
MAP_TILE_PROVIDER=osm
MAP_TILE_API_KEY=

# ---- Rate limiting ---------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120
