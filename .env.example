# Copy to .env and fill in real values. .env is gitignored.

# ====================== Backend ======================
APP_ENV=development
APP_DEBUG=true
APP_NAME=zerozero-api
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
API_V1_PREFIX=/api/v1

# Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=zerozero
POSTGRES_PASSWORD=zerozero_dev
POSTGRES_DB=zerozero
DATABASE_URL=postgresql+asyncpg://zerozero:zerozero_dev@db:5432/zerozero
DATABASE_URL_SYNC=postgresql+psycopg://zerozero:zerozero_dev@db:5432/zerozero

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OAuth (optional)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Geocoding
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=zerozero-dev

# Storage (dev uses local disk, prod uses S3-compatible)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
S3_ENDPOINT=
S3_BUCKET=zerozero
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Sentry (optional)
SENTRY_DSN=

# Email (dev uses mailhog)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=no-reply@zerozero.local

# ====================== Frontend ======================
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
VITE_APP_NAME=ZeroZero
VITE_DEFAULT_LAT=28.6139
VITE_DEFAULT_LNG=77.2090
VITE_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
